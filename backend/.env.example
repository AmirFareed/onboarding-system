# Application
APP_NAME=onboarding-automation-system
ENVIRONMENT=development
DEBUG=true
# At least 32 characters; production must set a strong random value.
SECRET_KEY=change-me-in-production-32-characters-minimum

# Database
DATABASE_URL=postgresql+psycopg://finance_app:change-me@localhost:5432/finance_verification

# Logging
LOG_LEVEL=INFO

# API
API_PREFIX=/api/v1

# Authentication
# Access tokens are short-lived JWTs carried in an HttpOnly cookie.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh-token lifetime when the user ticks "Remember this device".
REFRESH_TOKEN_EXPIRE_DAYS=30

# Default account created by `python -m app.auth.seed`.
# Production deployments MUST override the password (and ideally all of these).
DEFAULT_EMPLOYEE_ID=EMP-1001
DEFAULT_EMPLOYEE_EMAIL=employee@fintech.local
DEFAULT_EMPLOYEE_NAME=Employee
DEFAULT_EMPLOYEE_ROLE=Verification Officer
DEFAULT_EMPLOYEE_PASSWORD=Welcome@123

# Role accounts created by `python -m app.auth.seed`.
# OPERATOR: first-level document/completeness checker.
DEFAULT_OPERATOR_ID=OPR-1001
DEFAULT_OPERATOR_EMAIL=operator@fintech.local
DEFAULT_OPERATOR_NAME=Operator
DEFAULT_OPERATOR_PASSWORD=Welcome@123
# REVIEWER: second-level human verification.
DEFAULT_REVIEWER_ID=RVR-1001
DEFAULT_REVIEWER_EMAIL=reviewer@fintech.local
DEFAULT_REVIEWER_NAME=Reviewer
DEFAULT_REVIEWER_PASSWORD=Welcome@123
# IT: technical/administrative role (system logs, operational audit).
DEFAULT_IT_ID=IT-1001
DEFAULT_IT_EMAIL=it@fintech.local
DEFAULT_IT_NAME=IT
DEFAULT_IT_PASSWORD=Welcome@123

# Uploads
# UPLOAD_STORAGE_ROOT=/absolute/path/to/storage
MAX_UPLOAD_SIZE_MB=25
